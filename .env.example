# ========== LLM PROVIDER ==========

# Which provider to use for question generation. One of: ollama | gemini | openai
# If left unset, the app picks GEMINI_API_KEY > OPENAI_API_KEY > local Ollama.
LLM_PROVIDER=ollama

# --- Ollama (local, no API key needed) ---
# Requires `ollama serve` running locally with the model pulled, e.g.:
#   ollama pull llama3.1
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# --- Option: Google Gemini ---
# GEMINI_API_KEY=your_gemini_api_key_here

# --- Option: OpenAI (fallback) ---
# OPENAI_API_KEY=your_openai_api_key_here

# ========== STEP 2: BLOOM-ADAPTIVE RAG CONFIGURATION ==========

# Enable/disable Bloom-adaptive RAG (default: true)
# When enabled, retrieval k dynamically adjusts based on Bloom's taxonomy level
BLOOM_RAG_ENABLED=true

# Retrieval k values for different Bloom levels
# Bloom 1-2 (Remember/Understand): Use fewer chunks
BLOOM_K_LOW=4

# Bloom 3-4 (Apply/Analyze): Use moderate chunks
BLOOM_K_MED=8

# Bloom 5-6 (Evaluate/Create): Use more chunks for comprehensive context
BLOOM_K_HIGH=13

# ========== STEP 3: PEDAGOGY TAGGER CONFIGURATION ==========

# Enable/disable automatic pedagogy tagging (default: true)
# When enabled, questions are tagged with Course Outcomes (CO) and Program Outcomes (PO).
# This must be on for the CO-PO Attainment Matrix in Analytics to show more than one CO.
ENABLE_PEDAGOGY_TAGGER=true

# ========== STEP 5: GUARDIAN SYLLABUS VALIDATOR ==========

# Enable/disable strict syllabus validation (default: true)
# Unit resolution for the question bank (which unit a topic belongs to) always
# runs regardless of this flag — this only controls whether off-syllabus topics
# are rejected and regenerated.
GUARDIAN_ENABLED=true
