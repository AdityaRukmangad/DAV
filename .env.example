# ========== API KEY — use ONE of the following ==========
# Precedence if more than one is set: GROQ_API_KEY > GEMINI_API_KEY > OPENAI_API_KEY
# (so you can add GROQ_API_KEY to switch providers — e.g. Gemini hit its
# free-tier quota — without deleting your other key(s))

# Option 1: Groq (fast + generous free tier; uses openai/gpt-oss-120b / -20b)
# Get a free key at https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here

# Option 2: Google Gemini (recommended default)
GEMINI_API_KEY=your_gemini_api_key_here

# Option 3: OpenAI (fallback — only needed if not using Groq or Gemini)
# OPENAI_API_KEY=your_openai_api_key_here

# ========== STEP 2: BLOOM-ADAPTIVE RAG CONFIGURATION ==========

# Enable/disable Bloom-adaptive RAG (default: true)
# When enabled, retrieval k dynamically adjusts based on Bloom's taxonomy level
BLOOM_RAG_ENABLED=true

# Retrieval k values for different Bloom levels
# Bloom 1-2 (Remember/Understand): Use fewer chunks
BLOOM_K_LOW=4

# Bloom 3-4 (Apply/Analyze): Use moderate chunks
BLOOM_K_MED=8

# Bloom 5-6 (Evaluate/Create): Use more chunks for comprehensive context
BLOOM_K_HIGH=13

# ========== STEP 3: PEDAGOGY TAGGER CONFIGURATION ==========

# Enable/disable automatic pedagogy tagging (default: false)
# When enabled, questions are tagged with Course Outcomes (CO) and Program Outcomes (PO)
ENABLE_PEDAGOGY_TAGGER=false
